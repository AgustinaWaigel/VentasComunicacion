# PostgreSQL (Supabase)
# Usar el Transaction Pooler (puerto 6543) para la app
DATABASE_URL="postgresql://usuario:contraseña@host:6543/postgres"

# Usar el Session Pooler (puerto 5432) para migraciones (prisma db push)
DIRECT_URL="postgresql://usuario:contraseña@host:5432/postgres"

PORT=5000
NODE_ENV=development

# Mercado Pago (https://www.mercadopago.com/developers)
# Obtén tu ACCESS TOKEN en la sección de credenciales de tu cuenta de desarrollador
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Web Push Notifications (https://web-push-codelab.glitch.me/)
# Genera tus claves VAPID en el enlace anterior
# La clave pública se enviará al cliente, la privada solo en el servidor
VAPID_PUBLIC_KEY="BCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:admin@example.com"

# URLs para redirecciones y webhooks
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:5000"


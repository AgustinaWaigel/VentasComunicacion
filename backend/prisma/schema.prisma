generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id        Int      @id @default(autoincrement())
  nombre    String
  categoria String?  @default("")
  precio    Float    @default(0)
  costo     Float    @default(0)
  stock     Int      @default(0)
  imagen    String?
  detalles  DetalleVenta[]
}

model Evento {
  id          Int      @id @default(autoincrement())
  nombre      String
  fecha       String
  descripcion String?  @default("")
  activo      Boolean  @default(true)
  ventas      Venta[]
}

model Venta {
  id              Int      @id @default(autoincrement())
  fecha           DateTime @default(now())
  total           Float
  ganancia        Float    @default(0)
  metodoPago      String?  @default("efectivo")
  efectivo        Float?   @default(0)
  debe            Boolean  @default(false)
  
  // Nuevos campos para E-commerce
  estado          String   @default("completado") // pendiente_pago, preparando, listo, entregado, completado
  clienteNombre   String?
  clienteTelefono String?
  clienteDireccion String?
  mpPreferenceId  String?
  mpPaymentId     String?
  tipoEntrega     String?  @default("retiro") // retiro, envio

  eventoId        Int?
  evento          Evento?  @relation(fields: [eventoId], references: [id])
  detalles        DetalleVenta[]
}

model DetalleVenta {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  productoId Int
  cantidad   Int
  subtotal   Float
  ganancia   Float    @default(0)
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  rol       String   @default("admin")
  createdAt DateTime @default(now())
}

model SuscripcionPush {
  id          Int      @id @default(autoincrement())
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now())
}
